# ---------------------------------------------------------------------------
# Bastion — Security+ study app
# Copy to .env.local and fill in. Leave the Supabase values empty to run in
# demo mode (local file storage, demo account, no external services).
# ---------------------------------------------------------------------------

# Supabase project URL and public key (Project Settings -> API).
# Either the legacy anon key or the newer publishable key works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app. Used to build links in sign-up confirmation and
# password-reset emails. Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Only used by the `npm run questions:import` CLI to bulk-load
# questions. The web app never reads it. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode only (optional):
# Secret for signing demo session cookies. A random one is generated and
# stored with the demo data if unset.
DEMO_AUTH_SECRET=
# Where demo data is stored (default: ./.demo-data). Use /tmp/... on
# read-only hosts.
DEMO_DATA_DIR=
