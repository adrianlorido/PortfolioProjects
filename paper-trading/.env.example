# Copy to .env and adjust. No secrets are used by this application.
# All values are optional; the defaults are shown.

# SQLite database file (created by `python -m paper_trading init-sample`).
PAPER_DB_PATH=data/paper_trading.sqlite3

# Dashboard/API bind address. Keep 127.0.0.1 so it is reachable only locally.
PAPER_HOST=127.0.0.1
PAPER_PORT=8000

# Sample run. These values are pinned when the run is created. Changing any of
# them later requires a NEW sample run key; re-running init with the same key
# and different values is refused so existing results are never altered.
PAPER_SAMPLE_RUN_KEY=sample-run-001
PAPER_STARTING_CASH_CENTS=10000000
PAPER_WATCHLIST=SPY
PAPER_FEE_PER_CONTRACT_CENTS=65
# 100 basis points = 1% of starting cash per entry ($1,000 on $100,000).
PAPER_ENTRY_RISK_LIMIT_BPS=100

# Session boundaries are UTC instants; local dates are derived in the session
# timezone (09:30-16:00 America/New_York on 2026-09-29 by default).
PAPER_SESSION_START=2026-09-29T13:30:00Z
PAPER_SESSION_END=2026-09-29T20:00:00Z
PAPER_SESSION_TIMEZONE=America/New_York
