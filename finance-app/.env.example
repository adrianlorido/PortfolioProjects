# Copy to .env.local. Never commit real values.

# Data source. Phase 1 supports only "sample" (fully offline, deterministic fake data).
# "supabase" is reserved for Phase 2 and will fail fast if selected.
DATA_MODE=sample

# --- Phase 2 (not used yet) ---------------------------------------------------
# Public Supabase values (safe for the browser; access is enforced by RLS).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never import from client components.
# SUPABASE_SERVICE_ROLE_KEY=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
